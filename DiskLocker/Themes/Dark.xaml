<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ==================================================================
         深色令牌（默认主题）
         与 Themes/Light.xaml 保持完全相同的键名，只替换色值。
         控件样式一律用 DynamicResource 引用本字典，切换主题即时生效。
         ================================================================== -->

    <!-- ===================== 语义色 ===================== -->
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#6BA3FF</Color>
    <Color x:Key="AccentPressedColor">#3A73D6</Color>
    <Color x:Key="WarnColor">#F5A623</Color>
    <Color x:Key="WarnHoverColor">#FFB840</Color>
    <Color x:Key="SuccessColor">#3ED598</Color>
    <Color x:Key="DangerColor">#F2555A</Color>
    <Color x:Key="DangerHoverColor">#FF6E73</Color>
    <Color x:Key="DangerPressedColor">#CC4348</Color>

    <!-- ===================== 表面与文字 ===================== -->
    <Color x:Key="AppBgTopColor">#141519</Color>
    <Color x:Key="AppBgBottomColor">#181B22</Color>
    <Color x:Key="SidebarTopColor">#00FFFFFF</Color>
    <Color x:Key="SidebarBottomColor">#0DFFFFFF</Color>
    <Color x:Key="CardColor">#1F2127</Color>
    <Color x:Key="CardHoverColor">#262932</Color>
    <Color x:Key="ControlColor">#22252C</Color>
    <Color x:Key="ControlHoverColor">#2C3038</Color>
    <Color x:Key="ControlPressedColor">#343841</Color>
    <Color x:Key="InputColor">#181A1F</Color>
    <Color x:Key="StrokeColor">#2E313A</Color>
    <Color x:Key="StrokeStrongColor">#3B3F4A</Color>
    <Color x:Key="OverlayColor">#26FFFFFF</Color>
    <Color x:Key="ScrimColor">#59000000</Color>

    <Color x:Key="TextPrimaryColor">#F2F3F5</Color>
    <Color x:Key="TextSecondaryColor">#A8ADB8</Color>
    <Color x:Key="TextTertiaryColor">#8A909C</Color>
    <Color x:Key="TextMutedColor">#71767F</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <Color x:Key="TextDisabledColor">#5A5F69</Color>

    <!-- ===================== 状态胶囊（浅色底 + 同色描边 + 同色文字） ===================== -->
    <Color x:Key="PillAccentBgColor">#242F5C99</Color>
    <Color x:Key="PillAccentBorderColor">#4D4C8DFF</Color>
    <Color x:Key="PillAccentTextColor">#8FB4FF</Color>
    <Color x:Key="PillWarnBgColor">#24F5A623</Color>
    <Color x:Key="PillWarnBorderColor">#4DF5A623</Color>
    <Color x:Key="PillWarnTextColor">#F8BC55</Color>
    <Color x:Key="PillSuccessBgColor">#243ED598</Color>
    <Color x:Key="PillSuccessBorderColor">#4D3ED598</Color>
    <Color x:Key="PillSuccessTextColor">#63DFAC</Color>
    <Color x:Key="PillDangerBgColor">#28F2555A</Color>
    <Color x:Key="PillDangerBorderColor">#4DF2555A</Color>
    <Color x:Key="PillDangerTextColor">#F7797D</Color>
    <Color x:Key="PillNeutralBgColor">#14FFFFFF</Color>
    <Color x:Key="PillNeutralBorderColor">#24FFFFFF</Color>
    <Color x:Key="PillNeutralTextColor">#A8ADB8</Color>

    <!-- ===================== 引导条 / 提示条 ===================== -->
    <Color x:Key="BannerTopColor">#2A2C4E</Color>
    <Color x:Key="BannerBottomColor">#1E2536</Color>
    <Color x:Key="BannerBorderColor">#4D4C8DFF</Color>

    <!-- ===================== 画刷 ===================== -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnHoverBrush" Color="{StaticResource WarnHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.55,1">
        <GradientStop Color="#E6141519" Offset="0" />
        <GradientStop Color="#E6181B22" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource SidebarTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource SidebarBottomColor}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="PillAccentBgBrush" Color="{StaticResource PillAccentBgColor}" />
    <SolidColorBrush x:Key="PillAccentBorderBrush" Color="{StaticResource PillAccentBorderColor}" />
    <SolidColorBrush x:Key="PillAccentTextBrush" Color="{StaticResource PillAccentTextColor}" />
    <SolidColorBrush x:Key="PillWarnBgBrush" Color="{StaticResource PillWarnBgColor}" />
    <SolidColorBrush x:Key="PillWarnBorderBrush" Color="{StaticResource PillWarnBorderColor}" />
    <SolidColorBrush x:Key="PillWarnTextBrush" Color="{StaticResource PillWarnTextColor}" />
    <SolidColorBrush x:Key="PillSuccessBgBrush" Color="{StaticResource PillSuccessBgColor}" />
    <SolidColorBrush x:Key="PillSuccessBorderBrush" Color="{StaticResource PillSuccessBorderColor}" />
    <SolidColorBrush x:Key="PillSuccessTextBrush" Color="{StaticResource PillSuccessTextColor}" />
    <SolidColorBrush x:Key="PillDangerBgBrush" Color="{StaticResource PillDangerBgColor}" />
    <SolidColorBrush x:Key="PillDangerBorderBrush" Color="{StaticResource PillDangerBorderColor}" />
    <SolidColorBrush x:Key="PillDangerTextBrush" Color="{StaticResource PillDangerTextColor}" />
    <SolidColorBrush x:Key="PillNeutralBgBrush" Color="{StaticResource PillNeutralBgColor}" />
    <SolidColorBrush x:Key="PillNeutralBorderBrush" Color="{StaticResource PillNeutralBorderColor}" />
    <SolidColorBrush x:Key="PillNeutralTextBrush" Color="{StaticResource PillNeutralTextColor}" />

    <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource BannerTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource BannerBottomColor}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BannerBorderBrush" Color="{StaticResource BannerBorderColor}" />

    <!-- 深色下卡片靠描边分层，投影极轻 -->
    <DropShadowEffect x:Key="CardShadow" Color="#40000000" BlurRadius="18" ShadowDepth="1"
                      Direction="270" Opacity="0.35" />
    <DropShadowEffect x:Key="FlyoutShadow" Color="#80000000" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.6" />

    <!-- ===================== 字体 ===================== -->
    <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <sys:Double x:Key="TitleSize">22</sys:Double>
    <sys:Double x:Key="HeroSize">22</sys:Double>
    <sys:Double x:Key="SectionSize">13.5</sys:Double>
    <sys:Double x:Key="BodySize">12.5</sys:Double>
    <sys:Double x:Key="MetaSize">11.5</sys:Double>

    <!-- ===================== 尺寸（控件尺寸统一定义） ===================== -->
    <sys:Double x:Key="SidebarWidth">230</sys:Double>
    <sys:Double x:Key="TitleBarHeight">40</sys:Double>
    <sys:Double x:Key="ButtonHeight">32</sys:Double>
    <sys:Double x:Key="LargeButtonHeight">40</sys:Double>
    <sys:Double x:Key="InputHeight">40</sys:Double>
    <sys:Double x:Key="RowHeight">56</sys:Double>
    <sys:Double x:Key="NavHeight">40</sys:Double>
    <sys:Double x:Key="IconBoxSize">38</sys:Double>

    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <CornerRadius x:Key="SettingCardRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlRadius">9</CornerRadius>
    <CornerRadius x:Key="SmallControlRadius">8</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>

</ResourceDictionary>

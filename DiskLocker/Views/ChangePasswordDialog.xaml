<Window x:Class="DiskLocker.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改解锁密码"
        Width="500" SizeToContent="Height"
        Style="{StaticResource DialogWindow}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,24">

        <TextBlock Text="修改解锁密码" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="改完之后，解锁硬盘要用新密码。当前锁定状态不会改变。"
                   Style="{StaticResource MetaText}" Margin="0,6,0,0" />

        <TextBlock Text="当前密码" Style="{StaticResource FieldLabel}" Margin="0,20,0,7" />
        <PasswordBox x:Name="OldPwd" Style="{StaticResource PasswordInput}" />

        <TextBlock Text="新密码" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
        <PasswordBox x:Name="NewPwd" Style="{StaticResource PasswordInput}" PasswordChanged="NewPwd_Changed" />

        <!-- 强度条：四段 + 文字 -->
        <Grid Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="Seg1" Width="54" Height="4" CornerRadius="2" Margin="0,0,6,0"
                        Background="{DynamicResource StrokeBrush}" />
                <Border x:Name="Seg2" Width="54" Height="4" CornerRadius="2" Margin="0,0,6,0"
                        Background="{DynamicResource StrokeBrush}" />
                <Border x:Name="Seg3" Width="54" Height="4" CornerRadius="2" Margin="0,0,6,0"
                        Background="{DynamicResource StrokeBrush}" />
                <Border x:Name="Seg4" Width="54" Height="4" CornerRadius="2"
                        Background="{DynamicResource StrokeBrush}" />
            </StackPanel>
            <TextBlock x:Name="StrengthText" Grid.Column="1" Style="{StaticResource MetaText}"
                       Margin="12,0,0,0" VerticalAlignment="Center" Text="强度：--" />
        </Grid>

        <TextBlock Text="再输一遍新密码" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
        <PasswordBox x:Name="ConfirmPwd" Style="{StaticResource PasswordInput}"
                     KeyDown="ConfirmPwd_KeyDown" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource MetaText}" Margin="0,12,0,0"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <TextBlock Text="密码只保存在本机且不可找回，建议同时记录到密码管理器。"
                   Style="{StaticResource MetaText}" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="86" Click="Cancel_Click" />
            <Button Content="保存新密码" Style="{StaticResource LargePrimaryButton}" MinWidth="118"
                    Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>

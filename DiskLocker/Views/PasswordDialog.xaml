<Window x:Class="DiskLocker.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解锁硬盘"
        Width="420" Height="330"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 锁图标 + 标题 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,18">
            <Border Width="60" Height="60" CornerRadius="30"
                    Background="{StaticResource AccentLightBrush}"
                    Margin="0,0,0,12">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="26" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="输入密码解锁硬盘" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="DiskInfoText" Text="" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 密码输入 -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="密码" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox"
                         Style="{StaticResource ModernPasswordBox}"
                         KeyDown="PasswordBox_KeyDown" />
        </StackPanel>

        <!-- 提示信息 -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Text=""
                   FontSize="12" Foreground="{StaticResource DangerBrush}"
                   Margin="0,9,0,0" TextWrapping="Wrap" />

        <!-- 弹性占位 -->
        <TextBlock Grid.Row="3" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button Style="{StaticResource PrimaryButton}"
                    Click="UnlockButton_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="解锁" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="DiskLocker.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- 分组标题：左标题 + 右说明 -->
        <Style x:Key="GroupHeaderRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,26,0,10" />
        </Style>

        <!-- 设置卡内的一行 -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- 行首图标块 -->
        <Style x:Key="RowIcon" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource PillAccentBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PillAccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource AppScrollViewer}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,22,30,30">

            <!-- ============ 页头 + 自动保存提示 ============ -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource PageHeader}" />
                    <TextBlock Text="改动即时生效，不需要点保存。" Style="{StaticResource PageSubHeader}" />
                </StackPanel>
                <Border x:Name="SavedPill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,4,0,0" Visibility="Collapsed"
                        Background="{DynamicResource PillSuccessBgBrush}"
                        BorderBrush="{DynamicResource PillSuccessBorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource PillGlyph}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{DynamicResource PillSuccessTextBrush}" />
                        <TextBlock Text="改动已自动保存" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PillSuccessTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 安全与密码 ============ -->
            <Grid Style="{StaticResource GroupHeaderRow}" Margin="0,14,0,10">
                <TextBlock Text="安全与密码" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="密码使用 BCrypt 哈希后存储在本机" Style="{StaticResource MetaText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource SettingsCard}">
                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource RowIcon}">
                            <TextBlock Text="&#xE192;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0">
                            <TextBlock Text="解锁密码" Style="{StaticResource SettingRowTitle}" />
                            <TextBlock Text="解锁硬盘时需要输入这个密码，忘记了就没法找回。"
                                       Style="{StaticResource SettingRowDesc}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="修改密码" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Click="ChangePassword_Click" />
                    </Grid>
                </Border>
            </Border>

            <!-- ============ 锁定行为 ============ -->
            <Grid Style="{StaticResource GroupHeaderRow}">
                <TextBlock Text="锁定行为" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="满足条件时自动把硬盘锁起来" Style="{StaticResource MetaText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="一段时间不用电脑就自动锁定" Style="{StaticResource SettingRowTitle}" />
                                <TextBlock Text="选「禁用」表示一直不自动锁定。" Style="{StaticResource SettingRowDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="TimeoutCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                      Width="128" VerticalAlignment="Center"
                                      SelectionChanged="Timeout_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="锁屏时自动锁定" Style="{StaticResource SettingRowTitle}" />
                                <TextBlock Text="离开电脑锁屏后，硬盘也会跟着上锁。" Style="{StaticResource SettingRowDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="ScreenLockToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Checked="LockBehavior_Changed" Unchecked="LockBehavior_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="电脑睡眠时自动锁定" Style="{StaticResource SettingRowTitle}" />
                                <TextBlock Text="电脑进入睡眠或休眠后，硬盘也会跟着上锁。" Style="{StaticResource SettingRowDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="SleepToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Checked="LockBehavior_Changed" Unchecked="LockBehavior_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 启动与快捷键 ============ -->
            <Grid Style="{StaticResource GroupHeaderRow}">
                <TextBlock Text="启动与快捷键" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="让它安静地在后台工作" Style="{StaticResource MetaText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" Style="{StaticResource SettingRowTitle}" />
                                <TextBlock Text="电脑开机后在后台自动保护，不打扰你。" Style="{StaticResource SettingRowDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="呼出解锁窗口的快捷键" Style="{StaticResource SettingRowTitle}" />
                                <TextBlock Text="硬盘锁定时，按这个组合键可以快速输入密码解锁。"
                                           Style="{StaticResource SettingRowDesc}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Kbd}" Margin="0,0,10,0">
                                <TextBlock x:Name="HotKeyText" Style="{StaticResource MonoText}" Text="Ctrl + Alt + L" />
                            </Border>
                            <Button Grid.Column="2" Content="修改" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Center" Click="ChangeHotkey_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 关于与维护 ============ -->
            <Grid Style="{StaticResource GroupHeaderRow}">
                <TextBlock Text="关于与维护" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="ConfigPathHint" Text="配置文件位于 %APPDATA%\DiskLocker"
                           Style="{StaticResource MetaText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionTitle" Text="DiskLocker 1.0.0"
                                           Style="{StaticResource SettingRowTitle}" />
                                <TextBlock x:Name="VersionDesc" Text="硬盘保护助手"
                                           Style="{StaticResource SettingRowDesc}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="检查更新" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Center" Click="CheckUpdate_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="外观主题" Style="{StaticResource SettingRowTitle}" />
                                <TextBlock Text="深色为默认；选「跟随系统」时随 Windows 浅色/深色设置切换。"
                                           Style="{StaticResource SettingRowDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                      Width="128" VerticalAlignment="Center" SelectionChanged="Theme_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

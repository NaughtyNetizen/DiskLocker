<UserControl x:Class="DiskLocker.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskLocker.Views">
    <UserControl.Resources>
        <v:PillBrushConverter x:Key="PillBrush" />
        <v:BoolToVisibilityConverter x:Key="BoolVis" />

        <!-- 概览页硬盘行：图标 + 型号/元信息 + 状态胶囊 + 更多；未保护行改用添加保护按钮 -->
        <DataTemplate x:Key="DiskRowTemplate">
            <Border Margin="0,0,0,10" Padding="16,13" CornerRadius="14" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowUnprotectedActions}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PillWarnBgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PillWarnBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                            Background="{DynamicResource ControlBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0">
                        <TextBlock Text="{Binding Model}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding MetaLine}" Style="{StaticResource MetaText}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- 受保护：状态胶囊 + 更多菜单 -->
                    <Border Grid.Column="2" Style="{StaticResource PillSmall}" Margin="0,0,10,0"
                            Background="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=bg}"
                            BorderBrush="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=border}"
                            Visibility="{Binding ShowProtectedActions, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource PillGlyph}"
                                       Foreground="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=text}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=text}" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource MoreButton}" Tag="{Binding}"
                            Click="MoreButton_Click"
                            Visibility="{Binding ShowProtectedActions, Converter={StaticResource BoolVis}}" />

                    <!-- 未保护：一键添加保护 -->
                    <Button Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource PrimaryButton}"
                            Tag="{Binding}" Click="AddProtection_Click" HorizontalAlignment="Right"
                            Visibility="{Binding ShowUnprotectedActions, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="添加保护" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource AppScrollViewer}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,22,30,30">

            <!-- ============ 未配置引导条：任何一步都可跳过，但一直引导 ============ -->
            <Border x:Name="QuickStartBanner" Style="{StaticResource Banner}" Visibility="Collapsed" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Margin="0,0,14,0"
                            Background="{DynamicResource PillAccentBgBrush}"
                            BorderBrush="{DynamicResource PillAccentBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="软件已在后台运行，硬盘正在被监控" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="完成「开始保护」只需两步：选硬盘、设密码。行为偏好已按推荐值填好。"
                                   Style="{StaticResource MetaText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"
                            VerticalAlignment="Center" Click="QuickStart_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="开始保护" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 页头 + 状态胶囊 ============ -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource PageHeader}" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubHeader}"
                               Text="还没有添加要保护的硬盘。" />
                </StackPanel>
                <Border x:Name="HeaderPill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="HeaderPillGlyph" Text="&#xE72E;" Style="{StaticResource PillGlyph}" />
                        <TextBlock x:Name="HeaderPillText" Text="未保护" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 状态主卡 + 保护概览 ============ -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26" MinHeight="196">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="HeroCircle" Grid.Column="0" Width="104" Height="104" CornerRadius="52"
                                Background="{DynamicResource PillAccentBgBrush}"
                                BorderBrush="{DynamicResource PillAccentBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="HeroGlyph" Text="&#xE72E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="38" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                            <TextBlock x:Name="HeroTitle" Text="未保护" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="HeroDesc" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                                       Text="先把移动硬盘加进来，之后就能一键上锁。" />
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button x:Name="HeroPrimaryButton" Style="{StaticResource LargePrimaryButton}"
                                        Click="HeroPrimary_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HeroPrimaryGlyph" Text="&#xE710;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="HeroPrimaryText" Text="开始保护" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HeroSecondaryButton" Style="{StaticResource LargeSecondaryButton}"
                                        Margin="12,0,0,0" Click="HeroSecondary_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="HeroSecondaryText" Text="行为设置" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="保护概览" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="受保护硬盘" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="ProtectedCountValue" Grid.Column="1" Text="0 块" FontWeight="SemiBold"
                                       FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前盘符" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="DriveLettersValue" Grid.Column="1" Text="--" FontWeight="SemiBold"
                                       FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="设备连接" Style="{StaticResource SecondaryText}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Margin="0,0,7,0"
                                         Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnectionValue" Text="未连接" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="解锁快捷键" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource Kbd}">
                                <TextBlock x:Name="HotKeyValue" Style="{StaticResource MonoText}" Text="Ctrl + Alt + L" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 我的硬盘 ============ -->
            <Grid Margin="0,26,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="我的硬盘" Style="{StaticResource SectionHeader}" />
                    <Border x:Name="ProtectedPill" Style="{StaticResource PillSmall}" Margin="10,0,0,0"
                            Background="{DynamicResource PillNeutralBgBrush}"
                            BorderBrush="{DynamicResource PillNeutralBorderBrush}">
                        <TextBlock x:Name="ProtectedPillText" Text="0 块已保护" Style="{StaticResource PillText}" />
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="GoDisks_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="硬盘管理" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsControl x:Name="DiskList" ItemTemplate="{StaticResource DiskRowTemplate}" />

            <Border x:Name="EmptyDisksHint" Style="{StaticResource Card}" Padding="20,26" Margin="0,2,0,0"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="还没有检测到可保护的硬盘" Style="{StaticResource CardTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="插上移动硬盘后回到这一页，或点右上角「硬盘管理」刷新列表。"
                               Style="{StaticResource MetaText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

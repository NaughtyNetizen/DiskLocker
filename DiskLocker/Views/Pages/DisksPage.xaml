<UserControl x:Class="DiskLocker.Views.Pages.DisksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskLocker.Views">
    <UserControl.Resources>
        <v:PillBrushConverter x:Key="PillBrush" />
        <v:BoolToVisibilityConverter x:Key="BoolVis" />

        <!-- ============ 卡片视图：已保护 ============ -->
        <DataTemplate x:Key="ProtectedCardTemplate">
            <Border Style="{StaticResource Card}" Width="296" Margin="0,0,14,14" Padding="16"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" HorizontalAlignment="Left"
                                Background="{DynamicResource PillAccentBgBrush}"
                                BorderBrush="{DynamicResource PillAccentBorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PillSmall}"
                                Background="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=bg}"
                                BorderBrush="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=border}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource PillGlyph}"
                                           Foreground="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=text}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=text}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding Model}" Style="{StaticResource CardTitle}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding SerialText}" Style="{StaticResource MetaText}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding CapacityLine}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Height="30" Padding="13,0"
                                HorizontalAlignment="Left" Content="查看详情" Tag="{Binding}"
                                Click="Details_Click" />
                        <Button Style="{StaticResource MoreButton}" HorizontalAlignment="Right"
                                Tag="{Binding}" Click="More_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============ 卡片视图：可添加 ============ -->
        <DataTemplate x:Key="AvailableCardTemplate">
            <Border Style="{StaticResource Card}" Width="296" Margin="0,0,14,14" Padding="16"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" HorizontalAlignment="Left"
                                Background="{DynamicResource ControlBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PillSmall}"
                                Background="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=bg}"
                                BorderBrush="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=border}">
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=text}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding Model}" Style="{StaticResource CardTitle}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding SerialText}" Style="{StaticResource MetaText}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding CapacityLine}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Height="30" Padding="14,0"
                                HorizontalAlignment="Left" Tag="{Binding}" Click="Add_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="添加保护" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MoreButton}" HorizontalAlignment="Right"
                                Tag="{Binding}" Click="More_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============ 列表视图行 ============ -->
        <DataTemplate x:Key="DiskListRowTemplate">
            <Border Padding="16,0" Height="52" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StrokeBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180" />
                        <ColumnDefinition Width="1.2*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" MinWidth="78" />
                        <ColumnDefinition Width="Auto" MinWidth="96" />
                        <ColumnDefinition Width="Auto" MinWidth="96" />
                        <ColumnDefinition Width="Auto" MinWidth="44" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource ControlBrush}">
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Model}" Style="{StaticResource CardTitle}" Margin="10,0,8,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding SerialText}" Style="{StaticResource MetaText}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="3" Text="{Binding LettersText}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />

                    <Border Grid.Column="4" Style="{StaticResource PillSmall}" VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Background="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=bg}"
                            BorderBrush="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=border}">
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=text}" />
                    </Border>

                    <Button Grid.Column="5" Style="{StaticResource MoreButton}" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Tag="{Binding}" Click="More_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource AppScrollViewer}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,22,30,30">

            <!-- ============ 页头 + 刷新 ============ -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="硬盘管理" Style="{StaticResource PageHeader}" />
                    <TextBlock Text="添加或移除要保护的硬盘。锁定后硬盘会从电脑里隐藏。"
                               Style="{StaticResource PageSubHeader}" />
                </StackPanel>
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,0,0" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="刷新列表" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ 工具条：搜索 + 视图切换 ============ -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchInput}"
                         Tag="搜索" TextChanged="SearchBox_TextChanged" />
                <Border Grid.Column="2" Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="CardViewToggle" GroupName="DiskView" Style="{StaticResource SegmentButton}"
                                     IsChecked="True" Checked="View_Toggled">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="卡片" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ListViewToggle" GroupName="DiskView" Style="{StaticResource SegmentButton}"
                                     Checked="View_Toggled">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="列表" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 已保护的硬盘 ============ -->
            <Grid Margin="0,24,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="已保护的硬盘" Style="{StaticResource SectionHeader}" />
                    <Border x:Name="ProtectedPill" Style="{StaticResource PillSmall}" Margin="10,0,0,0"
                            Background="{DynamicResource PillNeutralBgBrush}"
                            BorderBrush="{DynamicResource PillNeutralBorderBrush}">
                        <TextBlock x:Name="ProtectedPillText" Text="0 块" Style="{StaticResource PillText}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="锁定后盘符会从系统中隐藏" Style="{StaticResource MetaText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl x:Name="ProtectedCards" ItemTemplate="{StaticResource ProtectedCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- 列表视图的表头，与行模板共用列宽 -->
            <Border x:Name="ListHeader" Style="{StaticResource Card}" Padding="16,0" Height="40"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180" />
                        <ColumnDefinition Width="1.2*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" MinWidth="78" />
                        <ColumnDefinition Width="Auto" MinWidth="96" />
                        <ColumnDefinition Width="Auto" MinWidth="96" />
                        <ColumnDefinition Width="Auto" MinWidth="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="硬盘" Style="{StaticResource PillText}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="序列号" Style="{StaticResource PillText}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="容量" Style="{StaticResource PillText}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="3" Text="当前盘符" Style="{StaticResource PillText}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource PillText}" />
                    <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource PillText}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Border x:Name="ListBody" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <ItemsControl x:Name="ProtectedRows" ItemTemplate="{StaticResource DiskListRowTemplate}" />
            </Border>

            <TextBlock x:Name="NoProtectedText" Style="{StaticResource MetaText}" Margin="2,2,0,0"
                       Visibility="Collapsed"
                       Text="还没有保护任何硬盘，从下方挑一块加进来吧。" />

            <!-- ============ 可以添加的硬盘 ============ -->
            <Grid Margin="0,26,0,12">
                <TextBlock Text="可以添加的硬盘" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="AvailableHint" Style="{StaticResource MetaText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl x:Name="AvailableCards" ItemTemplate="{StaticResource AvailableCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border x:Name="AvailableListBody" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <ItemsControl x:Name="AvailableRows" ItemTemplate="{StaticResource DiskListRowTemplate}" />
            </Border>

            <TextBlock x:Name="NoAvailableText" Style="{StaticResource MetaText}" Margin="2,2,0,0"
                       Visibility="Collapsed"
                       Text="没有检测到其他可添加的硬盘，插上移动硬盘后点「刷新列表」。" />

        </StackPanel>
    </ScrollViewer>
</UserControl>

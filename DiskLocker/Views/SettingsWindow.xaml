<Window x:Class="DiskLocker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:DiskLocker.Views.Pages"
        Title="DiskLocker"
        Width="1000" Height="660"
        MinWidth="820" MinHeight="560"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航栏 ============ -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,8,8,8">
                <!-- 应用标识 -->
                <StackPanel Orientation="Horizontal" Margin="10,4,0,20">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="DiskLocker" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="硬盘保护助手" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 一级导航 -->
                <Button x:Name="NavHomeButton" Style="{StaticResource NavItemButton}" Tag="Selected"
                        Click="NavHomeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="首页" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavDisksButton" Style="{StaticResource NavItemButton}"
                        Click="NavDisksButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="磁盘管理" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavSettingsButton" Style="{StaticResource NavItemButton}"
                        Click="NavSettingsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="设置" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost" />
        </Grid>
    </Grid>
</Window>

<Window x:Class="DiskLocker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskLocker.ViewModels"
        Title="DiskLocker"
        Width="1120" Height="660"
        MinWidth="900" MinHeight="560"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- 已保护磁盘卡片模板 -->
        <DataTemplate x:Key="ProtectedDiskTemplate" DataType="{x:Type vm:DiskCardModel}">
            <Border Style="{StaticResource DiskCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="8"
                                Background="{StaticResource AccentLightBrush}">
                            <TextBlock Text="&#xEDA2;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SizeDisplay}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SerialNumber, StringFormat='S/N: {0}'}" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DriveLettersText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="移除" Tag="{Binding}"
                                Click="RemoveDiskCard_Click"
                                Style="{StaticResource SubtleButton}"
                                Foreground="{StaticResource DangerBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 可添加磁盘卡片模板 -->
        <DataTemplate x:Key="AvailableDiskTemplate" DataType="{x:Type vm:DiskCardModel}">
            <Border Style="{StaticResource DiskCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="8"
                                Background="{StaticResource SubtleBrush}">
                            <TextBlock Text="&#xEDA2;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SizeDisplay}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SerialNumber, StringFormat='S/N: {0}'}" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
                    <Button Tag="{Binding}"
                            Click="AddDiskCard_Click"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="添加保护" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,4,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左列：状态总览 ============ -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0">
            <ScrollViewer Style="{StaticResource ModernScrollViewer}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="状态总览" Style="{StaticResource NavColumnHeader}" />

                <!-- 大锁图标 -->
                <Border x:Name="StatusIconCircle" Width="76" Height="76" CornerRadius="38"
                        Background="{StaticResource AccentLightBrush}"
                        HorizontalAlignment="Center" Margin="0,10,0,16">
                    <TextBlock x:Name="StatusIconGlyph" Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets" FontSize="32"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="LockStateText" Text="已锁定" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="LockStateSubText" Text="盘符已隐藏，拒绝访问" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" />

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,18" />

                <!-- 信息行 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse x:Name="ConnectionDot" Style="{StaticResource StatusDot}"
                                 Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Text="连接状态" Style="{StaticResource LabelText}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectionStatusText" Grid.Row="0" Grid.Column="1"
                               Text="--" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="当前盘符"
                               Style="{StaticResource LabelText}" Margin="0,0,0,12" />
                    <TextBlock x:Name="DriveLettersText" Grid.Row="1" Grid.Column="1"
                               Text="--" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="目标硬盘"
                               Style="{StaticResource LabelText}" />
                    <TextBlock x:Name="TargetCountText" Grid.Row="2" Grid.Column="1"
                               Text="--" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 操作按钮 -->
                <Button x:Name="LockButton"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,24,0,10" HorizontalAlignment="Stretch"
                        Click="LockButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="立即锁定" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="UnlockButton"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,0,24" HorizontalAlignment="Stretch"
                        Click="UnlockButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="解锁硬盘" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ 中列：磁盘管理 ============ -->
        <ScrollViewer Grid.Column="1" Style="{StaticResource ModernScrollViewer}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">
                <!-- 已保护硬盘 -->
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="已保护硬盘" Style="{StaticResource NavColumnHeader}" Margin="0" />
                    <TextBlock x:Name="ProtectedCountText" Text="" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl x:Name="ProtectedDisksControl"
                              ItemTemplate="{StaticResource ProtectedDiskTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="NoProtectedText"
                           Text="尚未添加目标硬盘，请从下方添加。"
                           Style="{StaticResource DescriptionText}"
                           Visibility="Collapsed" Margin="0,4,0,0" />

                <!-- 可添加硬盘 -->
                <Grid Margin="0,24,0,12">
                    <TextBlock Text="可添加硬盘" Style="{StaticResource NavColumnHeader}" Margin="0" />
                    <Button Click="RefreshButton_Click"
                            Style="{StaticResource SubtleButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl x:Name="AvailableDisksControl"
                              ItemTemplate="{StaticResource AvailableDiskTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="NoAvailableText"
                           Text="没有检测到其他可添加的硬盘。"
                           Style="{StaticResource DescriptionText}"
                           Visibility="Collapsed" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 右列：设置 ============ -->
        <ScrollViewer Grid.Column="2" Style="{StaticResource ModernScrollViewer}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 自动锁定 -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="自动锁定" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="无操作超时" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <ComboBox x:Name="TimeoutComboBox"
                                  Style="{StaticResource ModernComboBox}" Margin="0,0,0,14">
                            <ComboBoxItem Content="禁用" Tag="0" />
                            <ComboBoxItem Content="5 分钟" Tag="5" />
                            <ComboBoxItem Content="10 分钟" Tag="10" />
                            <ComboBoxItem Content="15 分钟" Tag="15" />
                            <ComboBoxItem Content="30 分钟" Tag="30" />
                            <ComboBoxItem Content="60 分钟" Tag="60" />
                        </ComboBox>
                        <CheckBox x:Name="LockOnScreenLockCheckBox"
                                  Content="系统锁屏时自动锁定"
                                  Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10" />
                        <CheckBox x:Name="LockOnSleepCheckBox"
                                  Content="系统休眠/睡眠时自动锁定"
                                  Style="{StaticResource ModernCheckBox}" Margin="0,0,0,14" />
                        <Button Content="保存自动锁定设置"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="SaveAutoLockButton_Click" />
                    </StackPanel>
                </Border>

                <!-- 修改密码 -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="修改密码" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="当前密码" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="OldPasswordBox"
                                     Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,10" />
                        <TextBlock Text="新密码" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="NewPasswordBox1"
                                     Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,10" />
                        <TextBlock Text="确认新密码" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="NewPasswordBox2"
                                     Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,14" />
                        <Button Content="修改密码"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="ChangePasswordButton_Click" />
                    </StackPanel>
                </Border>

                <!-- 其他设置 -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="其他设置" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="AutoStartCheckBox"
                                  Content="开机自动启动"
                                  Style="{StaticResource ModernCheckBox}" Margin="0,0,0,14"
                                  Checked="AutoStartCheckBox_Changed"
                                  Unchecked="AutoStartCheckBox_Changed" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="全局快捷键" Style="{StaticResource LabelText}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Background="{StaticResource AccentLightBrush}"
                                    CornerRadius="4" Padding="10,4">
                                <TextBlock x:Name="HotKeyText" Text="Ctrl + Alt + L"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="用于快速呼出解锁对话框"
                                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 状态消息 -->
                <TextBlock x:Name="StatusText" Text=""
                           FontSize="12" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="2,0,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

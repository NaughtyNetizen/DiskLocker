<Window x:Class="DiskLocker.Views.QuickStartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始保护你的硬盘"
        Width="560" SizeToContent="Height"
        Style="{StaticResource DialogWindow}"
        ResizeMode="CanResizeWithGrip"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 头部 ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="11" Margin="0,0,13,0"
                    Background="{DynamicResource PillAccentBgBrush}"
                    BorderBrush="{DynamicResource PillAccentBorderBrush}" BorderThickness="1">
                <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="18" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="开始保护你的硬盘" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="软件已经在后台运行了。只需两步就能开始保护，其余设置已按推荐值填好。"
                           Style="{StaticResource MetaText}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="420" />
            </StackPanel>
        </StackPanel>

        <!-- ============ ① 选择硬盘 ============ -->
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <Grid>
                <TextBlock Text="① 选择要保护的硬盘" Style="{StaticResource CardTitle}" />
                <TextBlock Text="可多选 · 已替你排除系统盘" Style="{StaticResource MetaText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer Style="{StaticResource AppScrollViewer}" MaxHeight="188" Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DiskPanel" />
            </ScrollViewer>
            <TextBlock x:Name="DiskEmptyText" Style="{StaticResource MetaText}" Margin="0,8,0,0"
                       Visibility="Collapsed"
                       Text="没有检测到可保护的硬盘，插上移动硬盘后再试，或先「稍后再说」，之后从概览页进入。" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource GhostButton}" Height="28" Padding="10,0" Content="刷新列表"
                        Click="Refresh_Click" />
                <TextBlock x:Name="SelectionSummary" Style="{StaticResource MetaText}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- ============ ② 设置密码 ============ -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Grid>
                <TextBlock Text="② 设置解锁密码" Style="{StaticResource CardTitle}" />
                <TextBlock Text="解锁硬盘时需要输入" Style="{StaticResource MetaText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="解锁密码" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
            <Grid Height="40">
                <PasswordBox x:Name="Pwd" Style="{StaticResource PasswordInput}" Padding="12,0,40,0"
                             PasswordChanged="Pwd_Changed" />
                <TextBox x:Name="PwdVisible" Style="{StaticResource InputBase}" Padding="12,0,40,0"
                         Visibility="Collapsed" TextChanged="PwdVisible_TextChanged" />
                <Button x:Name="EyeBtn" Style="{StaticResource IconButton}" Width="30" Height="30"
                        HorizontalAlignment="Right" Margin="0,0,5,0" Content="&#xE7B3;" Click="Eye_Click" />
            </Grid>
        </StackPanel>

        <!-- ============ 推荐值预填说明 ============ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,12" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Top" Margin="0,1,11,0" />
                <StackPanel MaxWidth="430">
                    <TextBlock Text="已按推荐值预填" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="空闲 30 分钟自动锁定 · 锁屏与睡眠时锁定 · 开机自启（之后都能在设置里改）"
                               Style="{StaticResource MetaText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Style="{StaticResource MetaText}" Margin="0,12,0,0"
                   Foreground="{DynamicResource WarnBrush}">
            <Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Run Text=" 密码只保存在本机且无法找回，请务必记牢。" />
        </TextBlock>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Style="{StaticResource MetaText}" Margin="0,8,0,0"
                   VerticalAlignment="Top" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" />

        <!-- ============ 底部按钮 ============ -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="稍后再说" Style="{StaticResource GhostButton}" Height="40" MinWidth="86"
                    Click="Later_Click" />
            <Button Style="{StaticResource LargePrimaryButton}" MinWidth="124" Margin="10,0,0,0"
                    Click="Start_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="开始保护" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>

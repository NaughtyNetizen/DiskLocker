<Window x:Class="DiskLocker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:DiskLocker.Behaviors"
        xmlns:pages="clr-namespace:DiskLocker.Views.Pages"
        Title="DiskLocker"
        Width="1280" Height="800"
        MinWidth="980" MinHeight="640"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：品牌 + 一级导航 + 常驻状态卡 ==================== -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource SidebarTopColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource SidebarBottomColor}" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 品牌 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,16,26">
                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="17" Foreground="{DynamicResource TextOnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock Text="DiskLocker" FontSize="14.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="硬盘保护助手" Style="{StaticResource MetaText}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 一级导航 -->
            <StackPanel Grid.Row="1" Margin="8,0,8,0">
                <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" IsChecked="True"
                             Checked="Nav_Checked" Tag="Overview">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,11,0" />
                        <TextBlock Text="概览" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavDisks" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Disks">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,11,0" />
                        <TextBlock Text="硬盘管理" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavActivity" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Activity">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,11,0" />
                        <TextBlock Text="活动记录" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,11,0" />
                        <TextBlock Text="设置" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- 常驻状态卡：任何页面都能看到锁定状态并一键解锁 -->
            <Border Grid.Row="3" Style="{StaticResource SettingsCard}" Margin="12,0,12,10" Padding="14,13">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="SidebarDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarStateText" Text="保护中" Style="{StaticResource CardTitle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SidebarCountText" Text="0 块" Style="{StaticResource MetaText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="SidebarHintText" Style="{StaticResource MetaText}" Margin="0,7,0,0"
                               Text="按 Ctrl + Alt + L 可随时解锁硬盘" />
                    <Button x:Name="SidebarActionButton" Style="{StaticResource SecondaryButton}"
                            Height="34" Margin="0,11,0,0" HorizontalAlignment="Stretch"
                            Click="SidebarAction_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="SidebarActionGlyph" Text="&#xE785;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="SidebarActionText" Text="解锁硬盘" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Grid.Row="4" Style="{StaticResource MetaText}"
                       Text="v1.0.0 · 以管理员权限运行" Margin="20,0,16,16" TextWrapping="Wrap" />
        </Grid>

        <!-- ==================== 右侧：内容页 + 抽屉浮层 ==================== -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost" Focusable="False" />

            <!-- 磁盘详情抽屉：从右侧滑出，压在内容之上 -->
            <Border x:Name="DrawerScrim" Background="{DynamicResource ScrimBrush}" Visibility="Collapsed"
                    MouseLeftButtonDown="DrawerScrim_Click" />
            <Border x:Name="DrawerHost" Width="440" HorizontalAlignment="Right" Visibility="Collapsed"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,1"
                    CornerRadius="16,0,0,16" Effect="{DynamicResource FlyoutShadow}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerShift" X="440" />
                </Border.RenderTransform>
                <ContentControl x:Name="DrawerContent" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</Window>

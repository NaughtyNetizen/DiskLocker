<Window x:Class="DiskLocker.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskLocker 配置向导"
        Width="980" Height="580"
        MinWidth="860" MinHeight="520"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="28,6,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 头部 ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,0">
            <Border Width="44" Height="44" CornerRadius="10"
                    Background="{StaticResource AccentBrush}">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="22" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="DiskLocker 配置向导" FontSize="19" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="首次使用请完成以下三步配置，之后可随时在设置中修改。" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- ============ 三步横向并排 ============ -->
        <Grid Grid.Row="1" Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 步骤 1：选择目标硬盘 -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="{StaticResource AccentBrush}">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="选择目标硬盘" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="勾选需要保护的硬盘（可多选）。"
                                   Style="{StaticResource DescriptionText}" Margin="0,0,0,10" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom"
                            Style="{StaticResource SubtleButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="刷新列表" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="DiskListBox"
                             Style="{StaticResource ModernListBox}"
                             SelectionMode="Multiple"
                             SelectionChanged="DiskListBox_SelectionChanged" />
                </DockPanel>
            </Border>

            <!-- 步骤 2：设置密码 -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="设置解锁密码" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="密码以 BCrypt 哈希保存，绝不存储明文。"
                               Style="{StaticResource DescriptionText}" Margin="0,0,0,14" />
                    <TextBlock Text="密码" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordBox1"
                                 Style="{StaticResource ModernPasswordBox}"
                                 PasswordChanged="PasswordBox_Changed" Margin="0,0,0,12" />
                    <TextBlock Text="确认密码" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordBox2"
                                 Style="{StaticResource ModernPasswordBox}"
                                 PasswordChanged="PasswordBox_Changed" />
                </StackPanel>
            </Border>

            <!-- 步骤 3：基本设置 -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="基本设置" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="配置自动锁定与启动行为。"
                               Style="{StaticResource DescriptionText}" Margin="0,0,0,14" />
                    <TextBlock Text="无操作自动锁定" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                    <ComboBox x:Name="TimeoutComboBox"
                              Style="{StaticResource ModernComboBox}" Margin="0,0,0,18">
                        <ComboBoxItem Content="禁用" Tag="0" />
                        <ComboBoxItem Content="5 分钟" Tag="5" />
                        <ComboBoxItem Content="10 分钟" Tag="10" />
                        <ComboBoxItem Content="15 分钟" Tag="15" />
                        <ComboBoxItem Content="30 分钟" Tag="30" IsSelected="True" />
                        <ComboBoxItem Content="60 分钟" Tag="60" />
                    </ComboBox>
                    <CheckBox x:Name="LockOnScreenLockCheckBox"
                              Content="系统锁屏时自动锁定"
                              Style="{StaticResource ModernCheckBox}"
                              IsChecked="True" Margin="0,0,0,12" />
                    <CheckBox x:Name="LockOnSleepCheckBox"
                              Content="系统休眠/睡眠时自动锁定"
                              Style="{StaticResource ModernCheckBox}"
                              IsChecked="True" Margin="0,0,0,12" />
                    <CheckBox x:Name="AutoStartCheckBox"
                              Content="开机自动启动"
                              Style="{StaticResource ModernCheckBox}"
                              IsChecked="True" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 底部状态栏 ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text=""
                       FontSize="12" Foreground="{StaticResource DangerBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button Content="完成配置" Style="{StaticResource PrimaryButton}"
                        Click="FinishButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="DiskLocker.Views.DiskDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskLocker.Views">
    <UserControl.Resources>
        <v:PillBrushConverter x:Key="PillBrush" />

        <Style x:Key="InfoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 头部 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Margin="0,0,13,0"
                    Background="{DynamicResource ControlBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="TitleText" Text="硬盘" Style="{StaticResource CardTitle}" FontSize="14.5" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource MetaText}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                    Click="Close_Click" VerticalAlignment="Top" />
        </Grid>

        <!-- ============ 状态行 + 单盘解锁 ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,13" Margin="0,18,0,0"
                Background="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=bg}"
                BorderBrush="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=border}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0"
                        Background="{DynamicResource CardBrush}">
                    <TextBlock x:Name="StatusGlyph" Text="&#xE72E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{Binding StatusBrushKey, Converter={StaticResource PillBrush}, ConverterParameter=text}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="StatusText" Text="已锁定" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="StatusDesc" Style="{StaticResource MetaText}" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="UnlockBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Content="立即解锁" Click="Unlock_Click" />
            </Grid>
        </Border>

        <!-- ============ 硬件信息 ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,15" Margin="0,14,0,0">
            <StackPanel>
                <Grid Style="{StaticResource InfoRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="型号" Style="{StaticResource MetaText}" />
                    <TextBlock Grid.Column="1" x:Name="ModelValue" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                </Grid>
                <Grid Style="{StaticResource InfoRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="序列号" Style="{StaticResource MetaText}" />
                    <TextBlock Grid.Column="1" x:Name="SerialValue" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                </Grid>
                <Grid Style="{StaticResource InfoRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="接口与容量" Style="{StaticResource MetaText}" />
                    <TextBlock Grid.Column="1" x:Name="InterfaceValue" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                </Grid>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="分区与盘符" Style="{StaticResource MetaText}" />
                    <TextBlock Grid.Column="1" x:Name="PartitionValue" Style="{StaticResource BodyText}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ 底部操作 ============ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="复制序列号" Style="{StaticResource SecondaryButton}" Click="Copy_Click" />
            <Button x:Name="RemoveBtn" Content="移除保护…" Style="{StaticResource DangerGhostButton}"
                    Margin="10,0,0,0" Click="Remove_Click" />
        </StackPanel>

        <TextBlock x:Name="FooterHint" Grid.Row="5" Style="{StaticResource MetaText}" Margin="0,12,0,0"
                   Text="锁定状态会被记住：电脑重启后这块硬盘仍保持隐藏。" />
    </Grid>
</UserControl>

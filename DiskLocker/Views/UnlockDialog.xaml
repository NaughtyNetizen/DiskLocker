<Window x:Class="DiskLocker.Views.UnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解锁硬盘"
        Width="460" Height="560"
        Style="{StaticResource DialogWindow}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 头部：图标 + 标题 + 硬盘信息 ============ -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Border x:Name="IconCircle" Width="68" Height="68" CornerRadius="34" Margin="0,0,0,16"
                    Background="{DynamicResource PillAccentBgBrush}"
                    BorderBrush="{DynamicResource PillAccentBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="IconGlyph" Text="&#xE72E;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="26" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText" Text="输入密码解锁硬盘" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource MetaText}" HorizontalAlignment="Center"
                       Margin="0,7,0,0" TextAlignment="Center"
                       Text="输入你设置的密码，硬盘就能恢复正常使用。" />
            <Border x:Name="DiskPill" Style="{StaticResource PillSmall}" Margin="0,14,0,0" HorizontalAlignment="Center"
                    Background="{DynamicResource PillAccentBgBrush}"
                    BorderBrush="{DynamicResource PillAccentBorderBrush}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DiskPillDot" Width="6" Height="6" Margin="0,0,7,0"
                             Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DiskPillText" Text="0 块硬盘" FontSize="11.5" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PillAccentTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ 密码输入 ============ -->
        <StackPanel Grid.Row="1" Margin="0,26,0,0">
            <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
            <Grid Height="40">
                <PasswordBox x:Name="Pwd" Style="{StaticResource PasswordInput}" Padding="12,0,40,0"
                             KeyDown="Pwd_KeyDown" PasswordChanged="Pwd_Changed" />
                <TextBox x:Name="PwdVisible" Style="{StaticResource InputBase}" Padding="12,0,40,0"
                         Visibility="Collapsed" KeyDown="Pwd_KeyDown" TextChanged="PwdVisible_TextChanged" />
                <Button x:Name="EyeBtn" Style="{StaticResource IconButton}" Width="30" Height="30"
                        HorizontalAlignment="Right" Margin="0,0,5,0" Content="&#xE7B3;" Click="Eye_Click" />
            </Grid>
            <TextBlock x:Name="ErrorText" Style="{StaticResource MetaText}" Margin="0,9,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap">
                <Run x:Name="ErrorGlyph" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Run x:Name="ErrorRun" Text="" />
            </TextBlock>
            <TextBlock x:Name="HintText" Style="{StaticResource MetaText}" Margin="0,9,0,0"
                       Text="连续输错 5 次会等待 30 秒才能重试，用于防止暴力破解。" />
        </StackPanel>

        <!-- ============ 底部按钮 ============ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="86" Click="Cancel_Click" />
            <Button x:Name="ActionButton" Style="{StaticResource LargePrimaryButton}" MinWidth="104"
                    Margin="10,0,0,0" Click="Action_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ActionGlyph" Text="&#xE785;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="ActionText" Text="解锁" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock x:Name="FooterText" Grid.Row="5" Style="{StaticResource MetaText}" TextAlignment="Center"
                   Margin="0,14,0,0" Text="锁定状态在电脑重启后依然保持" />
    </Grid>
</Window>

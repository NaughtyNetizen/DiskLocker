<Window x:Class="DiskLocker.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="460" SizeToContent="Height"
        Style="{StaticResource DialogWindow}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,24">

        <Border x:Name="IconCircle" Width="48" Height="48" CornerRadius="24" Margin="0,0,0,16"
                Background="{DynamicResource PillDangerBgBrush}"
                BorderBrush="{DynamicResource PillDangerBorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center">
            <TextBlock x:Name="IconGlyph" Text="&#xE74D;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="20" Foreground="{DynamicResource DangerBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="TitleText" Text="标题" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Style="{StaticResource SecondaryText}" TextAlignment="Center"
                   Margin="0,10,0,0" LineHeight="19" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource SecondaryButton}"
                    MinWidth="86" Click="Cancel_Click" />
            <Button x:Name="ConfirmBtn" Content="确定" Style="{StaticResource DangerButton}"
                    MinWidth="104" Margin="10,0,0,0" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
